<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="shop.ItemMapper">
  <select id="findAll" resultType="shop.Item">
    SELECT id, sku, name, stock FROM items ORDER BY id
  </select>
</mapper>
